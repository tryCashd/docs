{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cashd",
  "colors": {
    "primary": "#143fdb",
    "light": "#4c7bff",
    "dark": "#053060"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": []
  },
  "redirects": [
    { "source": "/errors/pairing_code_invalid", "destination": "/integration/errors/overview" },
    { "source": "/errors/reviewer_account_forbidden", "destination": "/integration/errors/overview" },
    { "source": "/errors/overlay_token_expired", "destination": "/integration/errors/overview" },
    { "source": "/errors/overlay_already_responded", "destination": "/integration/errors/overview" },
    { "source": "/errors/reset_code_invalid", "destination": "/integration/errors/overview" },
    { "source": "/errors/reset_code_expired", "destination": "/integration/errors/overview" },
    { "source": "/errors/reset_code_max_attempts", "destination": "/integration/errors/overview" },
    { "source": "/errors/weak_password", "destination": "/integration/errors/overview" },
    { "source": "/errors/checkout_session_expired", "destination": "/integration/errors/overview" },
    { "source": "/errors/:slug*", "destination": "/integration/errors/:slug*" }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Merchant portal",
      "href": "https://merchant.trycashd.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Cashd",
        "items": [
          {
            "label": "Integration support",
            "href": "mailto:integrations@trycashd.com"
          },
          {
            "label": "Operations",
            "href": "mailto:ops@trycashd.com"
          }
        ]
      }
    ]
  }
}
