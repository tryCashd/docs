{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cashd",
  "colors": {
    "primary": "#143fdb",
    "light": "#4c7bff",
    "dark": "#053060"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "integration",
